# Copy this file to .env and fill in real values. .env is never committed.

# App
NODE_ENV=development
PORT=3000

# Frontend origin allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Database / cache
# When running with `npm run start:dev` on your own machine (no Docker), use localhost.
# When running via `docker compose up`, docker-compose.yml overrides these to the
# container network addresses automatically — you don't need to change this file for that.
MONGODB_URI=mongodb://localhost:27017/codeguardian
REDIS_URL=redis://localhost:6379

# Tasks a single user may start per calendar month (RF.66)
MONTHLY_TASK_LIMIT=50

# Python agent service base URL
AGENTS_SERVICE_URL=http://agents:8000

# Object storage for exported PDF artifacts (BE-20).
# Local/docker-compose: points at the bundled MinIO service, path-style
# addressing required. Real deployment: drop S3_ENDPOINT and
# S3_FORCE_PATH_STYLE entirely, set S3_REGION and real credentials — the
# same @aws-sdk/client-s3 code talks to either.
REPORTS_BUCKET_NAME=code-guardian-reports
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Secrets — generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse these example placeholders for anything real.
JWT_SECRET=changeme
CREDENTIAL_MASTER_KEY=changeme
INTERNAL_SHARED_SECRET=changeme
