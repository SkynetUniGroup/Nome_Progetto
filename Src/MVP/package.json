{
  "name": "codeguardian-MVP-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "pnpm format && pnpm lint",
    "test:unit": "vitest run --coverage",
    "test:integration:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:integration:test": "vitest run --config vitest.integration.config.ts",
    "test:integration:down": "docker-compose -f docker-compose.test.yml down",
    "test:integration": "pnpm test:integration:up && pnpm test:integration:test && pnpm test:integration:down",
    "test": "pnpm test:unit && pnpm test:integration"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome format --write"
    ],
    "*.py": [
      "python -m black"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@vitest/coverage-v8": "^4.1.11",
    "lint-staged": "^17.4.1",
    "vitest": "^4.1.11"
  },
  "vitest": {
    "environment": "node",
    "globals": true,
    "include": [
      "**/*.specs.ts"
    ],
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "json",
        "html"
      ]
    }
  }
}
