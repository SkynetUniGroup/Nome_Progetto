# Copia questo file in .env e riempi i valori reali. .env non viene mai committato.
# docker-compose.yml lo richiede (env_file: ./agents/.env): senza, `docker
# compose` si rifiuta di partire.

# --- Comunicazione interna col backend ---------------------------------
# Deve coincidere con INTERNAL_SHARED_SECRET di backend/.env: e' la chiave
# con cui vengono firmate in HMAC-SHA256 le chiamate agli endpoint interni.
INTERNAL_SHARED_SECRET=changeme
BACKEND_BASE_URL=http://backend:3000

# --- Prompt -------------------------------------------------------------
# Dentro il container i prompt stanno in /app/prompts (vedi Dockerfile).
# In locale, fuori da Docker, puntalo alla cartella prompts/ del progetto.
PROMPTS_DIR=/app/prompts

# --- Persistenza --------------------------------------------------------
MONGO_URI=mongodb://mongodb:27017/codeguardian
REDIS_URL=redis://redis:6379

# --- Modello ------------------------------------------------------------
# 'bedrock' usa le credenziali AWS della catena standard e AWS_REGION.
# Qualsiasi altro valore seleziona il provider su API gestita, che richiede
# LLM_API_KEY e LLM_BASE_URL.
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL_GENERAL=qwen3-32b
LLM_MODEL_SECURITY=qwen3-coder-30b-a3b-instruct
AWS_REGION=eu-south-1

# --- Limiti operativi ---------------------------------------------------
MAX_SCOPE_CHARS=60000
MAX_TOOL_ROUNDS=8
CHANGELOG_MIN_READABILITY=50.0
